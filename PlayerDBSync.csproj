<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Windows app: WinForms on top of PlayerDBSync.Core. (PlayerDBSync.Avalonia is the one for Linux, and Windows too.) -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- So the solution still builds on Linux (it only builds there; this app runs on Windows) -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The site's emblem (its public/images/emblem.webp), for the exe; the window loads it from the embedded copy below -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- The tests and the other projects are in folders under this one -->
    <DefaultItemExcludes>$(DefaultItemExcludes);PlayerDBSync.Tests\**;PlayerDBSync.Core\**;PlayerDBSync.Avalonia\**</DefaultItemExcludes>
  </PropertyGroup>

  <Import Project="AppVersion.props" />

  <ItemGroup>
    <ProjectReference Include="PlayerDBSync.Core\PlayerDBSync.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The site's backgrounds (its public/images/background*.webp), shown behind the pages -->
    <EmbeddedResource Include="Backgrounds\*.webp" />
    <EmbeddedResource Include="app.ico" />
  </ItemGroup>

</Project>
