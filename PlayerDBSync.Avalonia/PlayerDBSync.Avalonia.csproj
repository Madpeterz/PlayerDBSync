<Project Sdk="Microsoft.NET.Sdk">

  <!-- The cross-platform app (Linux, and Windows too): Avalonia on top of PlayerDBSync.Core. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PlayerDBSync</RootNamespace>
    <AssemblyName>PlayerDBSync.Avalonia</AssemblyName>
    <ApplicationIcon>..\app.ico</ApplicationIcon>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <Import Project="..\AppVersion.props" />

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PlayerDBSync.Core\PlayerDBSync.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same emblem and backgrounds the Windows app has (the site's public/images) -->
    <AvaloniaResource Include="..\app.ico" Link="Assets\app.ico" />
    <AvaloniaResource Include="..\Backgrounds\*.webp" Link="Assets\Backgrounds\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
